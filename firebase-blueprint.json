{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "User profile with role management",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "surname": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "role": { "type": "string", "enum": ["super_admin", "admin", "moderator", "customer"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "lastActive": { "type": "string", "format": "date-time" }
      },
      "required": ["email"]
    },
    "Calculation": {
      "title": "Calculation Simulation",
      "description": "Saved salary or settlement simulation",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "grossSalary": { "type": "number" },
        "inss": { "type": "number" },
        "irt": { "type": "number" },
        "net": { "type": "number" },
        "indemnity": { "type": "number" },
        "vacation": { "type": "number" },
        "thirteenth": { "type": "number" },
        "total": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" },
        "type": { "type": "string", "enum": ["salario", "fecho", "indeminizacao"] }
      },
      "required": ["userId", "createdAt", "type"]
    },
    "GlobalStats": {
      "title": "Global Statistics",
      "description": "Aggregated stats for the admin dashboard",
      "type": "object",
      "properties": {
        "totalUsers": { "type": "number" },
        "totalSimulations": { "type": "number" },
        "lastUpdate": { "type": "string", "format": "date-time" }
      }
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "Individual user profiles"
    },
    "/calculations/{calcId}": {
      "schema": "Calculation",
      "description": "Saved calculations for users"
    },
    "/stats/global": {
      "schema": "GlobalStats",
      "description": "Global statistics"
    }
  }
}
