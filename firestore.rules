rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper Functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isUserDoc(userId) {
      return isOwner(userId);
    }

    function getRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function hasAdminRole() {
      let role = getRole();
      return role == 'admin' || role == 'super_admin';
    }

    function hasModeratorRole() {
       let role = getRole();
       return role == 'moderator' || role == 'admin' || role == 'super_admin';
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Entity Validations
    function isValidUser(data) {
      return data.keys().hasAll(['email']) &&
             data.email is string && data.email.size() <= 256 &&
             (data.get('name', '') is string && data.get('name', '').size() <= 100) &&
             (data.get('surname', '') is string && data.get('surname', '').size() <= 100) &&
             (data.get('role', 'customer') in ['super_admin', 'admin', 'moderator', 'customer']);
    }

    function isValidCalculation(data) {
      return data.keys().hasAll(['userId', 'createdAt', 'type']) &&
             data.userId == request.auth.uid &&
             data.type in ['salario', 'fecho', 'indeminizacao'] &&
             data.createdAt == request.time;
    }

    // Collection: Users
    match /users/{userId} {
      allow get: if isOwner(userId) || hasModeratorRole();
      allow list: if hasModeratorRole();
      
      allow create: if isOwner(userId) && isValidUser(request.resource.data) && 
                      (request.resource.data.get('role', 'customer') == 'customer');
      
      allow update: if (isOwner(userId) && isValidUser(request.resource.data) && 
                        request.resource.data.role == resource.data.role) || // Owner can't change role
                       (hasAdminRole() && isValidUser(request.resource.data)); // Admin can change role
      
      allow delete: if hasAdminRole();
    }

    // Collection: Calculations
    match /calculations/{calcId} {
      allow get: if isSignedIn() && (resource.data.userId == request.auth.uid || hasModeratorRole());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || hasModeratorRole());
      
      allow create: if isSignedIn() && isValidCalculation(request.resource.data);
      
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid && 
                       isValidCalculation(request.resource.data) &&
                       request.resource.data.userId == resource.data.userId;
      
      allow delete: if isSignedIn() && (resource.data.userId == request.auth.uid || hasAdminRole());
    }

    // Collection: Stats
    match /stats/{statId} {
      allow read: if isSignedIn(); // Logged in users can see stats
      allow write: if hasAdminRole(); // Only admins can update stats manually
    }
  }
}
