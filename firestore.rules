rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny for safety
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helper Functions ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function getUserRole() {
      // Direct email check for bootstrap admin, otherwise check user doc
      return request.auth.token.email == 'bartoantonio7@gmail.com' 
        ? 'super_admin' 
        : get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isSuperAdmin() {
      return isSignedIn() && getUserRole() == 'super_admin';
    }

    function isAdmin() {
      return isSignedIn() && (getUserRole() in ['super_admin', 'admin']);
    }

    function isModerator() {
      return isSignedIn() && (getUserRole() in ['super_admin', 'admin', 'moderator']);
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- Common Validations ---
    function isValidTimestamp(val) {
      return val == request.time;
    }

    // --- Collection: Users ---
    function isValidUserProfile(data) {
      return data.keys().hasAll(['email', 'name', 'role', 'createdAt']) &&
             data.email is string && data.email.size() <= 200 &&
             data.name is string && data.name.size() <= 100 &&
             data.role in ['super_admin', 'admin', 'moderator', 'customer'] &&
             isValidTimestamp(data.createdAt);
    }

    match /users/{userId} {
      allow get: if isOwner(userId) || isModerator();
      allow list: if isModerator();
      
      allow create: if isOwner(userId) && 
                    isValidUserProfile(incoming()) &&
                    incoming().role == (request.auth.token.email == 'bartoantonio7@gmail.com' ? 'super_admin' : 'customer') &&
                    incoming().email == request.auth.token.email;
      
      allow update: if isOwner(userId) && 
                    incoming().diff(existing()).affectedKeys().hasOnly(['name', 'surname', 'lastActive', 'role']) &&
                    (incoming().role == existing().role || isSuperAdmin());
    }

    // --- Collection: Calculations ---
    function isValidCalculation(data) {
      return data.keys().hasAll(['userId', 'type', 'createdAt']) &&
             data.userId == request.auth.uid &&
             data.type in ['salario', 'fecho'] &&
             isValidTimestamp(data.createdAt);
    }

    match /calculations/{calcId} {
      allow get: if isSignedIn() && (isOwner(existing().userId) || isModerator());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isModerator());
      
      allow create: if isSignedIn() && 
                    // No strict size check on calculations because it spreads results which can vary
                    isValidCalculation(incoming());
      
      allow delete: if isSignedIn() && (isOwner(existing().userId) || isAdmin());
    }

    // --- Collection: Stats ---
    match /stats/{statId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn(); // Allow users to increment stats on registration/calculation
    }

    // --- Connection Test ---
    match /_connection_test_/{docId} {
      allow get: if true;
    }
  }
}
